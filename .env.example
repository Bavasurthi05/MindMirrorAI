# Copy to .env and adjust before running `docker compose up`.

# Database
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=mental_health_db

# Backend JWT (REQUIRED — use a long, random, high-entropy value, at least 32 chars)
JWT_SECRET=please-generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Backend datasource (used for non-Docker local runs)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mental_health_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Backend -> ML service
ML_SERVICE_BASE_URL=http://localhost:8000

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
